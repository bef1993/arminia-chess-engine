# Lichess Bot Configuration for Arminia Chess Engine

[lichess]
token = "YOUR_LICHESS_BOT_TOKEN"  # Replace with your actual token

[engine]
dir = "./bin/"                    # Directory containing the engine executable
name = "arminia-uci"          # Name of the executable (use arminia-uci.exe on Windows)
protocol = "uci"                  # Protocol to use (uci or xboard)
uci_options = { Hash = 128, Threads = 1 } # Optional UCI options

[challenge]
accept_bot = true                 # Accept challenges from other bots
accept_human = true               # Accept challenges from humans
max_games = 1                     # Maximum concurrent games

[time_control]
default = { limit = 300, increment = 3 } # Default time control for challenges without one
min_increment = 0
min_limit = 10

[correspondence]
check_interval = 60               # Seconds between checks for correspondence moves
move_time = 60                    # Seconds to think for correspondence moves
